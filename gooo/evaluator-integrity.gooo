# Gooo evaluator-integrity metacode.
# This file is the semantic authority. Go artifacts are generated from it.
policy evaluator_integrity 1 12
precedence REFUTED>UNKNOWN>CLOSED
unknown_fields stage|step|reason|unknown_class|next_operation|blocked_by
improvement_rule same_identity_pair

# Exactly 12 cells: four per layer and four per lens.
cell C01 subject_identity FOUNDATION DRIVER equal subject_identity subject_claim
cell C02 goal_identity FOUNDATION OUTCOME equal goal_identity goal_claim
cell C03 denominator_identity FOUNDATION GUARDRAIL equal denominator_identity denominator_claim
cell C04 decision_precedence FOUNDATION OUTCOME precedence decision_events
cell C05 unknown_record COHERENCE GUARDRAIL unknown_record
cell C06 evidence_authority COHERENCE DRIVER authority evidence_authority evidence_authority_allowed
cell C07 go_toolchain_identity COHERENCE OUTCOME equal toolchain_identity toolchain_claim
cell C08 generator_identity COHERENCE DRIVER equal generator_identity generator_claim
cell C09 evaluator_identity REGRESSION OUTCOME digest_fresh evaluator_digest evaluator_digest_fresh evaluator_identity evaluator_claim
cell C10 subject_evaluator_separation REGRESSION GUARDRAIL separate subject_digest evaluator_digest
cell C11 bounded_amendment_authority REGRESSION DRIVER bounded_amendment
cell C12 human_decision_receipt REGRESSION GUARDRAIL human_receipt

